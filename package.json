{
  "name": "aureus-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "./scripts/up.sh",
    "status": "./scripts/up.sh --status",
    "db:start": "docker compose up -d postgres redis",
    "db:stop": "docker compose stop postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:test-reset": "tsx scripts/test-reset.ts",
    "db:validate": "tsx scripts/validate-db.ts",
    "db:seed": "tsx scripts/seed-engines.ts",
    "env:check": "tsx scripts/env-check.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "validate:live": "tsx scripts/validate-live-candidate.ts",
    "validation:compute": "tsx scripts/validation-compute.ts",
    "dev": "pnpm --filter @aureus/web dev",
    "build:web": "pnpm --filter @aureus/web build",
    "worker:once": "tsx apps/worker/src/run.ts once",
    "worker:watch": "tsx apps/worker/src/run.ts watch",
    "worker:start": "tsx apps/worker/src/run.ts start",
    "telegram:test": "tsx scripts/telegram-test.ts",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "v2:reevaluate": "tsx scripts/v2-reevaluate.ts",
    "db:test-reset-safe": "tsx scripts/test-reset-safe.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aureus/alert-engine": "workspace:*",
    "@aureus/config": "workspace:*",
    "@aureus/contracts": "workspace:*",
    "@aureus/db": "workspace:*",
    "@aureus/feature-engine": "workspace:*",
    "@aureus/ingestion": "workspace:*",
    "@aureus/legacy-import": "workspace:*",
    "@aureus/notifications": "workspace:*",
    "@aureus/outcome-engine": "workspace:*",
    "@aureus/rule-engine": "workspace:*",
    "@aureus/snapshot-engine": "workspace:*",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  }
}
