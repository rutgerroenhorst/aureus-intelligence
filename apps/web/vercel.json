{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "lhr1"
  ],
  "buildCommand": "cd ../.. && pnpm -r --filter './packages/*' run build && cd apps/web && pnpm exec next build",
  "functions": {
    "app/api/scan/route.ts": {
      "maxDuration": 300
    },
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  }
}
