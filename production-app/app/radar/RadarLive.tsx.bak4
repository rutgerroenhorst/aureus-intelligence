"use client";
import { useEffect, useState } from "react";
import Link from "next/link";
import type { BoardView } from "../../lib/boardSections";
import type { CandidateDecisionView } from "../../lib/candidateView";
import { TradeTicket } from "../../components/TradeTicket";
import { ago, usd, dexUrl } from "../../lib/format";

const MCAP_CEILING = 150_000;
const MCAP_BANDS: Array<{ id: string; label: string; min: number; max: number }> = [
  { id: "all", label: "tot 150k", min: 0, max: MCAP_CEILING },
  { id: "seed", label: "< 25k", min: 0, max: 25_000 },
  { id: "early", label: "25–75k", min: 25_000, max: 75_000 },
  { id: "late", label: "75–150k", min: 75_000, max: MCAP_CEILING },
];

function V2StatusBadge({ status, confidence }: { status: string | null; confidence: number | null }) {
  if (!status) return null;

  const style = {
    "STRUCTURALLY_QUALIFIED": { bg: "bg-emerald-900", text: "text-emerald-100", label: "Structurally Qualified" },
    "INSUFFICIENT_DATA": { bg: "bg-amber-900", text: "text-amber-100", label: "More Data Required" },
    "FATAL_REJECT": { bg: "bg-red-900", text: "text-red-100", label: "Filtered" },
  }[status] || { bg: "bg-gray-700", text: "text-gray-100", label: "Unknown" };

  return (
    <span
      className={`inline-block px-2 py-0.5 rounded text-xs font-semibold ${style.bg} ${style.text}`}
      title={`${style.label}${confidence != null ? ` (${Math.round(confidence)}% confidence)` : ""}`}
    >
      {style.label}
    </span>
  );
}

function CandidateCard({ v }: { v: CandidateDecisionView }) {
  const mcap = v.marketCapUsd;
  const liq = v.liquidityUsd;

  return (
    <Link href={`/candidate/${v.id}`} className="block border border-gray-700 rounded p-4 hover:border-gray-500 transition">
      <div className="flex justify-between items-start mb-3">
        <div>
          <h3 className="font-semibold text-gray-100">{v.symbol ?? "Unknown"}</h3>
          <p className="text-xs text-gray-400">{v.code ?? v.id.slice(0, 8)}</p>
        </div>
        <V2StatusBadge status={v.v2StructuralStatus} confidence={v.v2StructuralConfidence} />
      </div>

      <div className="grid grid-cols-2 gap-2 text-xs mb-3">
        <div>
          <p className="text-gray-500">MCap</p>
          <p className="text-gray-100">{mcap != null ? usd(mcap) : "—"}</p>
        </div>
        <div>
          <p className="text-gray-500">Liquidity</p>
          <p className="text-gray-100">{liq != null ? usd(liq) : "—"}</p>
        </div>
        <div>
          <p className="text-gray-500">Volume 24h</p>
          <p className="text-gray-100">{v.volumeUsd != null ? usd(v.volumeUsd) : "—"}</p>
        </div>
        <div>
          <p className="text-gray-500">Potential</p>
          <p className={v.potential != null && v.potential >= 0.35 ? "text-emerald-400" : v.potential != null && v.potential <= 0.12 ? "text-red-400" : "text-gray-100"}>
            {v.potential != null ? `${Math.round(v.potential * 100)}%` : "—"}
          </p>
        </div>
      </div>

      {v.v2StructuralStatus && (
        <div className="bg-gray-900 rounded p-2 mb-3 text-xs">
          <div className="space-y-1">
            <div>
              <p className="text-gray-500">Confidence</p>
              <p className="text-gray-100">{v.v2StructuralConfidence != null ? `${Math.round(v.v2StructuralConfidence)}%` : "Unknown"}</p>
            </div>
            {v.v2MissingFields.length > 0 && (
              <div>
                <p className="text-gray-500">Waiting for</p>
                <p className="text-amber-400 text-xs">{v.v2MissingFields.slice(0, 2).join(", ")}</p>
              </div>
            )}
          </div>
        </div>
      )}

      {v.primaryBlocker && <p className="text-xs text-amber-400 mb-2">{v.primaryBlocker}</p>}

      <div className="flex justify-between items-center text-xs">
        <span className="text-gray-500">{v.fresh ? "Fresh" : "Stale"}</span>
        <a href={dexUrl(v.mint, v.pool)} target="_blank" rel="noopener noreferrer" className="text-blue-400 hover:text-blue-300">
          chart ↗
        </a>
      </div>
    </Link>
  );
}

export function RadarLive({ initial }: { initial: BoardView }) {
  const [board, setBoard] = useState<BoardView>(initial);
  const [bandId, setBandId] = useState<string>("all");
  const [now, setNow] = useState<number>(() => Date.parse(initial.generatedAt) || 0);

  useEffect(() => {
    const saved = window.localStorage.getItem("aureus:mcapBand");
    if (saved && MCAP_BANDS.some((b) => b.id === saved)) setBandId(saved);
  }, []);

  const band = MCAP_BANDS.find((b) => b.id === bandId) ?? MCAP_BANDS[0]!;
  const inBand = (v: CandidateDecisionView) => {
    const mc = v.marketCapUsd;
    return mc != null && mc >= band.min && mc < band.max;
  };

  useEffect(() => {
    setNow(Date.now());
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    let alive = true;
    const poll = async () => {
      try {
        const res = await fetch("/api/action-board", { cache: "no-store" });
        if (res.ok && alive) setBoard(await res.json());
      } catch { /* keep last good */ }
    };
    const iv = setInterval(poll, 10_000);
    return () => { alive = false; clearInterval(iv); };
  }, []);

  const w = board.worker;
  const ready = board.sections.ENTRY_READY ?? [];
  const approaching = board.sections.ENTRY_APPROACHING ?? [];
  const watch = [...(board.sections.PRIMARY_WATCH ?? []), ...(board.sections.SETUP_FORMING ?? [])];

  const allCandidates = [...ready, ...approaching, ...watch].filter(inBand);
  const structQualified = allCandidates.filter((v) => v.v2StructuralStatus === "STRUCTURALLY_QUALIFIED").length;
  const insufficientData = allCandidates.filter((v) => v.v2StructuralStatus === "INSUFFICIENT_DATA").length;

  const actionable = (v: CandidateDecisionView) =>
    !["move_not_spent", "not_late_chase", "not_distributing"].some((g) =>
      (v.entryReadyBlockers ?? []).includes(g)
    ) && v.plan?.valid === true;

  const preferReal = (a: CandidateDecisionView, b: CandidateDecisionView) =>
    (b.potential ?? 0) - (a.potential ?? 0) ||
    Number(b.activity === "REAL") - Number(a.activity === "REAL");

  const pool = allCandidates.filter((v) => v.v2StructuralStatus !== "FATAL_REJECT").sort(preferReal);
  const focus = ready.filter(inBand).filter(actionable).sort(preferReal)[0] ?? null;
  const usable = pool.filter((v) => v.id !== focus?.id && actionable(v));

  return (
    <div className="min-h-screen bg-gray-950 text-gray-100">
      <div className="border-b border-gray-800 bg-gray-900 sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-4 py-4">
          <div className="flex justify-between items-center mb-4">
            <div>
              <h1 className="text-3xl font-bold">Radar</h1>
              <p className="text-sm text-gray-500">Live verification intelligence</p>
            </div>
            <div className="flex items-center gap-4">
              <span className={`w-2 h-2 rounded-full ${w.online ? "bg-emerald-500" : "bg-red-500"}`} />
              <span className="text-sm">{w.online ? "Live" : "Offline"}</span>
              {w.lastCycleAt && <span className="text-sm text-gray-500">scan {ago(w.lastCycleAt, now)} ago</span>}
            </div>
          </div>

          <div className="flex gap-2">
            {MCAP_BANDS.map((b) => (
              <button
                key={b.id}
                type="button"
                className={`px-3 py-1 rounded text-sm ${
                  b.id === bandId
                    ? "bg-blue-900 text-blue-100"
                    : "bg-gray-800 text-gray-300 hover:bg-gray-700"
                }`}
                onClick={() => { setBandId(b.id); window.localStorage.setItem("aureus:mcapBand", b.id); }}
              >
                {b.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 py-8">
        <div className="grid grid-cols-3 gap-4 mb-8">
          <div className="bg-gray-900 rounded border border-gray-800 p-4">
            <p className="text-xs text-gray-500 mb-1">Monitored</p>
            <p className="text-2xl font-bold">{allCandidates.length}</p>
          </div>
          <div className="bg-gray-900 rounded border border-gray-800 p-4">
            <p className="text-xs text-gray-500 mb-1">Structurally Qualified</p>
            <p className="text-2xl font-bold text-emerald-400">{structQualified}</p>
          </div>
          <div className="bg-gray-900 rounded border border-gray-800 p-4">
            <p className="text-xs text-gray-500 mb-1">Waiting for Data</p>
            <p className="text-2xl font-bold text-amber-400">{insufficientData}</p>
          </div>
        </div>

        <div className="bg-gray-900 rounded border border-gray-800 p-6 mb-8">
          <h2 className="text-lg font-semibold mb-4">Current State</h2>
          {ready.length > 0 ? (
            <p className="text-gray-200">
              <span className="text-emerald-400 font-semibold">{ready.length}</span> candidate{ready.length === 1 ? "" : "s"} ready.
            </p>
          ) : focus != null ? (
            <p className="text-gray-200">
              <span className="text-amber-400 font-semibold">{usable.length}</span> candidate{usable.length === 1 ? "" : "s"} worth attention.
            </p>
          ) : (
            <p className="text-gray-400">No clean setup right now.</p>
          )}
        </div>

        {focus && (
          <div className="mb-8">
            <h2 className="text-lg font-semibold mb-4">{ready.length > 0 ? "Ready" : "Closest"}</h2>
            <TradeTicket v={focus} live={ready.length > 0 && actionable(focus)} />
          </div>
        )}

        {usable.length > 0 && (
          <div className="mb-8">
            <h2 className="text-lg font-semibold mb-4">Worth Attention</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {usable.slice(0, 12).map((v) => (
                <CandidateCard key={v.id} v={v} />
              ))}
            </div>
          </div>
        )}

        <div className="bg-gray-900 rounded border border-gray-800 p-4 text-xs text-gray-400">
          <p className="mb-2 font-semibold text-gray-300">Phase 1 Verification Status:</p>
          <ul className="space-y-1">
            <li className="text-emerald-400">• Structurally Qualified: Passed all Phase 1 gates · Deep verification pending</li>
            <li className="text-amber-400">• More Data Required: Missing critical structural fields</li>
            <li className="text-gray-500">• Filtered: Does not meet structural requirements</li>
          </ul>
        </div>
      </div>
    </div>
  );
}
