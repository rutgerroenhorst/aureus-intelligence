# ─────────────────────────────────────────────────────────────────────────
# Aureus Intelligence — environment
# Copy to .env.local and fill in. .env.local is gitignored and NEVER committed.
# No secrets are ever placed in chat, code, or version control.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (matches docker-compose.yml defaults) ──
DATABASE_URL=postgres://aureus:aureus@localhost:5432/aureus
# Role-scoped URLs (optional; created by 0002_roles.sql). Fall back to DATABASE_URL.
DATABASE_URL_APP=postgres://aureus_app:change_me@localhost:5432/aureus
DATABASE_URL_OUTCOME=postgres://aureus_outcome:change_me@localhost:5432/aureus
DATABASE_URL_READONLY=postgres://aureus_readonly:change_me@localhost:5432/aureus

# ── Redis (rate limiting + cache) ──
REDIS_URL=redis://localhost:6379

# ── Helius (Solana on-chain backbone) ──
# OPTIONAL. Leave empty to run on-chain features in MOCK/DEGRADED mode:
#   - on-chain checks report UNAVAILABLE/STALE instead of fabricating data
#   - Safety can NEVER become PASSED while critical Helius data is missing
# To go live later: paste your key here in .env.local (never in chat/code), then
# restart the worker. That single step flips Helius from MOCK to LIVE.
HELIUS_API_KEY=

# ── Dex Screener ── (public REST, no key). Polling only (no WebSocket exists).
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# ── GeckoTerminal ── (public REST, no key). Verification + OHLCV, 10 rpm free tier.
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# ── Bubblemaps ── iframe evidence only unless a data key is provided (gated).
BUBBLEMAPS_API_KEY=
BUBBLEMAPS_MODE=iframe

# ── Telegram notifications ──
# Secrets ONLY in .env.local (gitignored). Never paste the token into chat/code.
# Setup steps: see docs/TELEGRAM_SETUP.md. Test with: pnpm telegram:test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_MIN_ALERT_LEVEL=WATCH
TELEGRAM_COOLDOWN_MINUTES=15

# ── Continuous scanner (worker) ──
DISCOVERY_POLL_INTERVAL_SECONDS=60
ACTIVE_CANDIDATE_POLL_INTERVAL_SECONDS=30
RESEARCHING_POLL_INTERVAL_SECONDS=60
WATCHLIST_POLL_INTERVAL_SECONDS=20
STALE_AFTER_SECONDS=180
MAX_CANDIDATES_PER_CYCLE=25
MAX_CONCURRENT_CANDIDATES=5
WORKER_TICK_SECONDS=10
# Public base URL used in alert deep-links (candidate pages):
AUREUS_PUBLIC_URL=http://localhost:3000

# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── On-chain enrichment (Helius) ──
ENRICHMENT_MAX_ATTEMPTS=5
ENRICHMENT_TTL_MINUTES=360
MAX_ENRICH_PER_CYCLE=5
# ── Active-candidate monitoring ──
MONITORING_WINDOW_HOURS=168
